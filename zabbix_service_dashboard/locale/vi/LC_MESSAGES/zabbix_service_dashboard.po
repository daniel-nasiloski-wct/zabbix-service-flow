msgid "APM dashboard"
msgstr "Bảng điều khiển APM"

msgid "Actions"
msgstr "Thao tác"

msgid "Edit"
msgstr "Chỉnh sửa"

msgid "Save"
msgstr "Lưu"

msgid "Cancel"
msgstr "Hủy"

msgid "Remove"
msgstr "Gỡ bỏ"

msgid "Nothing to remove"
msgstr "Không có gì để gỡ bỏ"

msgid "Nothing to save"
msgstr "Không có gì để lưu"

msgid "Invalid time range or filter"
msgstr "Khoảng thời gian hoặc bộ lọc không hợp lệ"

msgid "Application"
msgstr "Ứng dụng"

msgid "Time range"
msgstr "Khoảng thời gian"

msgid "All applications (overview)"
msgstr "Tất cả ứng dụng (tổng quan)"

msgid "Last %1$s minutes"
msgstr "%1$s phút gần nhất"

msgid "Overview"
msgstr "Tổng quan"

msgid "Back to %1$s"
msgstr "Quay lại %1$s"

msgid "Remove application"
msgstr "Gỡ bỏ ứng dụng"

msgid "Remove service"
msgstr "Gỡ bỏ dịch vụ"

msgid "Remove application \"%1$s\" from the map?"
msgstr "Gỡ bỏ ứng dụng \"%1$s\" khỏi bản đồ?"

msgid "Remove service \"%1$s\" from the map?"
msgstr "Gỡ bỏ dịch vụ \"%1$s\" khỏi bản đồ?"

msgid "Its services, databases and external calls leave the map. Services shared with other applications stay."
msgstr "Các dịch vụ, cơ sở dữ liệu và lời gọi bên ngoài của nó sẽ biến mất khỏi bản đồ. Các dịch vụ dùng chung với ứng dụng khác vẫn được giữ lại."

msgid "The service, its connections, databases and external calls leave the map."
msgstr "Dịch vụ này cùng các kết nối, cơ sở dữ liệu và lời gọi bên ngoài của nó sẽ biến mất khỏi bản đồ."

msgid "If the application is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "Nếu ứng dụng được phát hiện lại trong các trace mới, nó sẽ tự động được tạo lại cùng toàn bộ thực thể."

msgid "If the service is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "Nếu dịch vụ được phát hiện lại trong các trace mới, nó sẽ tự động được tạo lại cùng toàn bộ thực thể."

msgid "Hosts, items and triggers in Zabbix are not changed."
msgstr "Host, item và trigger trong Zabbix không bị thay đổi."

msgid "Remove %1$s"
msgstr "Gỡ bỏ %1$s"

msgid "No data found"
msgstr "Không tìm thấy dữ liệu"

msgid "No APM span matches the attribute filter in the selected time range. Change the filter above or press Reset to see everything."
msgstr "Không có span APM nào khớp với bộ lọc thuộc tính trong khoảng thời gian đã chọn. Hãy đổi bộ lọc ở trên hoặc bấm Đặt lại để xem tất cả."

msgid "No APM traces in the selected time range and no host with the apm.requests item. Services appear here as soon as the applications send traces to the Zabbix proxy."
msgstr "Không có trace APM trong khoảng thời gian đã chọn và không có host nào có item apm.requests. Dịch vụ sẽ xuất hiện ở đây ngay khi các ứng dụng gửi trace tới Zabbix proxy."

