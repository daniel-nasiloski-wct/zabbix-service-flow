msgstr "დაბრუნება: %1$s"

msgid "Remove application"
msgstr "აპლიკაციის წაშლა"

msgid "Remove service"
msgstr "სერვისის წაშლა"

msgid "Remove application \"%1$s\" from the map?"
msgstr "წავშალოთ აპლიკაცია \"%1$s\" რუკიდან?"

msgid "Remove service \"%1$s\" from the map?"
msgstr "წავშალოთ სერვისი \"%1$s\" რუკიდან?"

msgid "Its services, databases and external calls leave the map. Services shared with other applications stay."
msgstr "მისი სერვისები, მონაცემთა ბაზები და გარე გამოძახებები რუკიდან გაქრება. სხვა აპლიკაციებთან საზიარო სერვისები რჩება."

msgid "The service, its connections, databases and external calls leave the map."
msgstr "სერვისი, მისი კავშირები, მონაცემთა ბაზები და გარე გამოძახებები რუკიდან გაქრება."

msgid "If the application is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "თუ აპლიკაცია ახალ ტრეისებში ისევ აღმოჩნდება, ის ავტომატურად თავიდან შეიქმნება ყველა თავისი ერთეულით."

msgid "If the service is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "თუ სერვისი ახალ ტრეისებში ისევ აღმოჩნდება, ის ავტომატურად თავიდან შეიქმნება ყველა თავისი ერთეულით."

msgid "Hosts, items and triggers in Zabbix are not changed."
msgstr "Zabbix-ის ჰოსტები, ელემენტები და ტრიგერები არ იცვლება."

msgid "Remove %1$s"
msgstr "წაშლა: %1$s"

msgid "No data found"
msgstr "მონაცემები ვერ მოიძებნა"

msgid "No APM span matches the attribute filter in the selected time range. Change the filter above or press Reset to see everything."
msgstr "არჩეულ დროის შუალედში ატრიბუტების ფილტრს არც ერთი APM span არ ემთხვევა. შეცვალეთ ფილტრი ზემოთ ან დააჭირეთ „გადატვირთვას“, რომ ყველაფერი ნახოთ."

msgid "No APM traces in the selected time range and no host with the apm.requests item. Services appear here as soon as the applications send traces to the Zabbix proxy."
msgstr "არჩეულ დროის შუალედში APM ტრეისები არ არის და არც ჰოსტი ელემენტით apm.requests. სერვისები აქ გამოჩნდება, როგორც კი აპლიკაციები ტრეისებს Zabbix proxy-ს გაუგზავნიან."

