msgstr "חזרה אל %1$s"

msgid "Remove application"
msgstr "הסרת יישום"

msgid "Remove service"
msgstr "הסרת שירות"

msgid "Remove application \"%1$s\" from the map?"
msgstr "להסיר את היישום \"%1$s\" מהמפה?"

msgid "Remove service \"%1$s\" from the map?"
msgstr "להסיר את השירות \"%1$s\" מהמפה?"

msgid "Its services, databases and external calls leave the map. Services shared with other applications stay."
msgstr "השירותים, מסדי הנתונים והקריאות החיצוניות שלו ייעלמו מהמפה. שירותים המשותפים עם יישומים אחרים יישארו."

msgid "The service, its connections, databases and external calls leave the map."
msgstr "השירות, החיבורים, מסדי הנתונים והקריאות החיצוניות שלו ייעלמו מהמפה."

msgid "If the application is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "אם היישום יתגלה שוב בעקבות חדשות, הוא ייווצר מחדש אוטומטית עם כל הישויות שלו."

msgid "If the service is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "אם השירות יתגלה שוב בעקבות חדשות, הוא ייווצר מחדש אוטומטית עם כל הישויות שלו."

msgid "Hosts, items and triggers in Zabbix are not changed."
msgstr "מארחים, פריטים וטריגרים ב-Zabbix אינם משתנים."

msgid "Remove %1$s"
msgstr "הסרת %1$s"

msgid "No data found"
msgstr "לא נמצאו נתונים"

msgid "No APM span matches the attribute filter in the selected time range. Change the filter above or press Reset to see everything."
msgstr "אף span של APM אינו תואם למסנן התכונות בטווח הזמן שנבחר. שנו את המסנן למעלה או לחצו על איפוס כדי לראות הכול."

msgid "No APM traces in the selected time range and no host with the apm.requests item. Services appear here as soon as the applications send traces to the Zabbix proxy."
msgstr "אין עקבות APM בטווח הזמן שנבחר ואין מארח עם הפריט apm.requests. השירותים יופיעו כאן ברגע שהיישומים ישלחו עקבות ל-proxy של Zabbix."

