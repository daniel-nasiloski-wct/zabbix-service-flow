msgstr "Olib tashlash"

msgid "Nothing to remove"
msgstr "Olib tashlash uchun hech narsa yo'q"

msgid "Nothing to save"
msgstr "Saqlash uchun hech narsa yo'q"

msgid "Invalid time range or filter"
msgstr "Vaqt oralig'i yoki filtr noto'g'ri"

msgid "Application"
msgstr "Ilova"

msgid "Time range"
msgstr "Vaqt oralig'i"

msgid "All applications (overview)"
msgstr "Barcha ilovalar (umumiy ko'rinish)"

