msgid "APM dashboard"
msgstr "Πίνακας APM"

msgid "Actions"
msgstr "Ενέργειες"

msgid "Edit"
msgstr "Επεξεργασία"

msgid "Save"
msgstr "Αποθήκευση"

msgid "Cancel"
msgstr "Άκυρο"

msgid "Remove"
msgstr "Αφαίρεση"

msgid "Nothing to remove"
msgstr "Τίποτα προς αφαίρεση"

msgid "Nothing to save"
msgstr "Τίποτα προς αποθήκευση"

msgid "Invalid time range or filter"
msgstr "Μη έγκυρο χρονικό διάστημα ή φίλτρο"

msgid "Application"
msgstr "Εφαρμογή"

msgid "Time range"
msgstr "Χρονικό διάστημα"

msgid "All applications (overview)"
msgstr "Όλες οι εφαρμογές (επισκόπηση)"

msgid "Last %1$s minutes"
msgstr "Τελευταία %1$s λεπτά"

msgid "Overview"
msgstr "Επισκόπηση"

msgid "Back to %1$s"
msgstr "Πίσω στο %1$s"

msgid "Remove application"
msgstr "Αφαίρεση εφαρμογής"

msgid "Remove service"
msgstr "Αφαίρεση υπηρεσίας"

msgid "Remove application \"%1$s\" from the map?"
msgstr "Αφαίρεση της εφαρμογής \"%1$s\" από τον χάρτη;"

msgid "Remove service \"%1$s\" from the map?"
msgstr "Αφαίρεση της υπηρεσίας \"%1$s\" από τον χάρτη;"

msgid "Its services, databases and external calls leave the map. Services shared with other applications stay."
msgstr "Οι υπηρεσίες, οι βάσεις δεδομένων και οι εξωτερικές κλήσεις της φεύγουν από τον χάρτη. Οι υπηρεσίες που μοιράζονται με άλλες εφαρμογές παραμένουν."

msgid "The service, its connections, databases and external calls leave the map."
msgstr "Η υπηρεσία, οι συνδέσεις, οι βάσεις δεδομένων και οι εξωτερικές κλήσεις της φεύγουν από τον χάρτη."

msgid "If the application is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "Αν η εφαρμογή ανακαλυφθεί ξανά σε νέα ίχνη, δημιουργείται αυτόματα ξανά, με όλες τις οντότητές της."

msgid "If the service is discovered again in new traces, it is recreated automatically, with all its entities."
msgstr "Αν η υπηρεσία ανακαλυφθεί ξανά σε νέα ίχνη, δημιουργείται αυτόματα ξανά, με όλες τις οντότητές της."

msgid "Hosts, items and triggers in Zabbix are not changed."
msgstr "Οι κόμβοι, τα στοιχεία και οι ενεργοποιητές στο Zabbix δεν αλλάζουν."

msgid "Remove %1$s"
msgstr "Αφαίρεση %1$s"

msgid "No data found"
msgstr "Δεν βρέθηκαν δεδομένα"

msgid "No APM span matches the attribute filter in the selected time range. Change the filter above or press Reset to see everything."
msgstr "Κανένα APM span δεν ταιριάζει με το φίλτρο χαρακτηριστικών στο επιλεγμένο χρονικό διάστημα. Αλλάξτε το φίλτρο παραπάνω ή πατήστε Επαναφορά για να δείτε τα πάντα."

msgid "No APM traces in the selected time range and no host with the apm.requests item. Services appear here as soon as the applications send traces to the Zabbix proxy."
msgstr "Δεν υπάρχουν ίχνη APM στο επιλεγμένο χρονικό διάστημα ούτε κόμβος με το στοιχείο apm.requests. Οι υπηρεσίες εμφανίζονται εδώ μόλις οι εφαρμογές στείλουν ίχνη στον Zabbix proxy."

